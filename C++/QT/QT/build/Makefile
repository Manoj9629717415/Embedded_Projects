src/Vehicle/Vehicle.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/QTApp.dir/build.make CMakeFiles/QTApp.dir/src/Vehicle/Vehicle.cpp.s
.PHONY : src/Vehicle/Vehicle.cpp.s

